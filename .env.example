# ===========================================
# 암웨이 ABO 웰니스 AI - 공통 환경 변수
# 이 파일을 .env 로 복사한 뒤 실제 값을 채워주세요.
# ===========================================

# 서버
NODE_ENV=development
PORT=3001

# 프론트엔드(웹뷰) CORS 및 리다이렉트용
# 개발 환경(NODE_ENV=development)에서는 CORS가 모든 origin을 허용합니다.
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3001

# 데이터베이스 (개발: SQLite, 운영: PostgreSQL)
# SQLite 기본값 (schema.prisma가 있는 backend/prisma 기준 상대경로)
DATABASE_URL="file:./dev.db"
# Docker PostgreSQL 사용 시 (docker-compose up -d db)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/amway?schema=public"
# docker-compose Postgres 비밀번호 (로컬 개발 시에도 .env에서 지정 권장)
POSTGRES_PASSWORD=

# OpenAI API (GPT-4o / text-embedding-3)
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 카카오 i Open Builder / 비즈메시지 API
KAKAO_CHANNEL_TOKEN=
KAKAO_API_KEY=
KAKAO_API_BASE=https://kapi.kakao.com
# 카카오 스킬 서버 출처 검증용 비밀값 (x-kakao-secret 헤더). 운영에서 미설정 시 웹훅 거부
KAKAO_WEBHOOK_SECRET=
# 업로드 이미지 URL 기준 주소 (미설정 시 요청 Host 사용 — 운영에서는 반드시 설정)
PUBLIC_API_URL=https://api.example.com

# 1:1 오픈채팅/채널 URL (홈 캘린더 쿠킹 클래스 신청 버튼용)
VITE_KAKAO_CHANNEL_URL=https://open.kakao.com/o/swrk4QLi

# 암웨이 공식몰 a-clic 후원자 번호
A_CLIC_SPONSOR_ID=1234567

# 벡터 DB (Pinecone 또는 Chroma)
PINECONE_API_KEY=
PINECONE_INDEX=amway-products
CHROMA_URL=http://localhost:8000

# 암호화 (AES-256) - 32바이트(64자 hex) 키
ENCRYPTION_KEY=

# 관리자 로그인 (/joohee0229 관리자 페이지)
# ADMIN_PASSWORD: 관리자 로그인 비밀번호
# ADMIN_SESSION_SECRET: 세션 토큰 서명용 임의의 긴 문자열 (예: openssl rand -hex 32)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
